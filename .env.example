# Copy to .env.local for local dev (never commit .env.local).
# In Vercel: Project → Settings → Environment Variables (Production + Preview).
# NEVER prefix these with VITE_ — VITE_* variables are bundled into the browser.

# ---- Required ---------------------------------------------------------------------------

# LLM (free tier, no card): https://console.groq.com
# Free-plan models checked 2026-11-11 via the account's /models endpoint: openai/gpt-oss-120b,
# openai/gpt-oss-20b — 1,000 requests/day, 8,000 tokens/min and 200,000 tokens/day EACH
# (the daily token limit is the real ceiling: ~80 answers on the primary). (Llama models are no
# longer available on the free plan.)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Allowed site origins for /api/chat (comma-separated). On Vercel the deployment's own URLs
# (VERCEL_URL / VERCEL_BRANCH_URL / VERCEL_PROJECT_PRODUCTION_URL) are added automatically.
CHAT_ALLOWED_ORIGINS=https://sreeharisuresh.vercel.app,http://localhost:3000,http://localhost:5173

# ---- Recommended ------------------------------------------------------------------------

# Fallback LLM: a second Groq model with its own quota (doubles capacity at $0; doesn't help
# if Groq itself is down). Without it, a failed primary call returns the "busy" message.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Rate limiting (free tier): https://console.upstash.com
# Without these, local dev uses an in-memory limiter (not suitable for production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Optional ---------------------------------------------------------------------------

# Which fallback to use: "groq" (default, uses GROQ_FALLBACK_MODEL) or "gemini".
# Gemini is NOT in use: this Google project has no Gemini free tier (it requires billing,
# which breaks the $0 rule). The code is kept so a provider can be switched in later.
# CHAT_FALLBACK_PROVIDER=groq
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Limit overrides (defaults from docs/chatbot/chatbot-settings.md):
# Per visitor (IP): burst per minute (every request = 1), then message budgets per hour/day.
# CHAT_RATE_PER_IP_MINUTE=6
# CHAT_RATE_PER_IP_HOUR=40
# CHAT_RATE_PER_IP_DAY=30
# All visitors: questions that reach the main LLM per day (router replies don't count).
# Default 120: Groq allows 200,000 tokens/day per model; an answer costs ~1,750 tokens (~2,200
# for a hiring answer) and the router also spends the fallback model's daily tokens. The
# arithmetic is in docs/chatbot/chatbot-settings.md (Limits).
# CHAT_RATE_GLOBAL_DAY=120
# Query understanding (router): one small call that classifies the message and rewrites it as
# a standalone search query. "off" disables it (the embedding gate decides, as before).
# CHAT_ROUTER=on
# Router model (default: GROQ_FALLBACK_MODEL).
# CHAT_ROUTER_MODEL=openai/gpt-oss-20b
# Router calls per day, all visitors (~800 tokens each). Past it, the embedding gate decides.
# CHAT_ROUTER_GLOBAL_DAY=120
# CHAT_ROUTER_TIMEOUT_MS=3000
# Fast path: a first message of more than 3 words with relevance at least this skips the router.
# CHAT_ROUTER_FAST_PATH=0.7
# Cost of a request answered without the main LLM (router reply, gate refusal, chip, cached),
# as a fraction 0–1.
# CHAT_REFUSED_WEIGHT=0.25
# Semantic answer cache for first-turn questions (stored in Upstash; "off" disables it).
# CHAT_ANSWER_CACHE=on
# CHAT_CACHE_SIMILARITY=0.95
# CHAT_CACHE_TTL_DAYS=7
# CHAT_CACHE_MAX_ENTRIES=500
# CHAT_MAX_MESSAGE_CHARS=500
# CHAT_HISTORY_TO_MODEL=6
# CHAT_MAX_ANSWER_TOKENS=240
# CHAT_PROVIDER_TIMEOUT_MS=15000
